# Clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=telescope
CLICKHOUSE_PASSWORD=change_me_in_production
CLICKHOUSE_DB=telescope

# Grafana
GRAFANA_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Processing
PCAP_INBOX_DIR=/var/lib/network-telescope/data/queue
POLL_INTERVAL_SECONDS=10
READY_AGE_SECONDS=5
INSERT_BATCH_SIZE=10000

# GeoIP
GEOIP_CACHE_SIZE=200000
MAXMIND_ACCOUNT_ID=change_me_in_production
MAXMIND_LICENSE_KEY=change_me_in_production

# Health monitoring
PROMETHEUS_URL=http://localhost:9090
ALERT_WEBHOOK_URL=

# Prometheus scrape target (change in production)
CAPTURING_NODE_IP=localhost
CAPTURING_NODE_EXPORTER_PORT=9100

# Processing node's /metrics endpoint port
METRICS_PORT=8000

# Capture directory mountpoint
CAPTURE_MOUNTPOINT=/var/lib/network-telescope