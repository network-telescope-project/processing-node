# Clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=telescope
CLICKHOUSE_PASSWORD=change_me_in_production
CLICKHOUSE_DB=telescope

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# Processing
PCAP_INBOX_DIR=/var/lib/network-telescope/data/queue
PCAP_ARCHIVE_DIR=/var/lib/network-telescope/data/archive
PCAP_QUARANTINE_DIR=/var/lib/network-telescope/data/quarantine
POLL_INTERVAL_SECONDS=10
READY_AGE_SECONDS=5
INSERT_BATCH_SIZE=10000
# Only packets addressed to these are stored. Same value as DARKNET_NETS on the capturing node
# (addresses and prefixes written as their network, e.g. 198.51.100.42,66.245.204.0/23). Empty = store all (local mode only)
DARKNET_NETS=
# The oldest archive files are deleted first when any limit is exceeded; 0 disables a limit
ARCHIVE_MAX_GB=30
ARCHIVE_MIN_FREE_GB=20
ARCHIVE_MAX_AGE_DAYS=90

# GeoIP
GEOIP_CACHE_SIZE=200000
MAXMIND_ACCOUNT_ID=change_me_in_production
MAXMIND_LICENSE_KEY=change_me_in_production

# Health monitoring
PROMETHEUS_URL=http://localhost:9090
ALERT_WEBHOOK_URL=
DISK_LOW_THRESHOLD_PCT=20
INGEST_STALE_SECONDS=7200

# Prometheus scrape target (change in production)
CAPTURING_NODE_IP=localhost
CAPTURING_NODE_EXPORTER_PORT=9100

# Processing node's /metrics endpoint port
METRICS_PORT=8000

# Capture directory path / mountpoint
CAPTURE_MOUNTPOINT=/var/lib/network-telescope