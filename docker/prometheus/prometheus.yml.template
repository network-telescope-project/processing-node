global:
  scrape_interval: 60s
  evaluation_interval: 60s

# TODO configure Alertmanager later

scrape_configs:

  # Prometheus self-monitoring
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # Capturing nodes (prometheus-node-exporter). The targets, labelled sensor=<id>, are written by the processing
  # node from the sensor registry (python -m src.registry add-sensor ... --exporter host:port)
  - job_name: capturing-node
    file_sd_configs:
      - files: ['/etc/prometheus/targets/capturing-nodes.json']
        refresh_interval: 1m
    relabel_configs:
      - target_label: node
        replacement: capturing

  # Processing pipeline
  - job_name: processing-pipeline
    static_configs:
      - targets: ['host.docker.internal:${METRICS_PORT}']
    relabel_configs:
      - target_label: node
        replacement: processing
