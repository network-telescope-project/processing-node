<clickhouse>
    <!-- Read-only account for Grafana and for looking at the data by hand. The limits keep a heavy query from starving the ingest -->
    <profiles>
        <nt_reader>
            <!-- 2 = may only read, but a client may set its own (stricter) settings, as the Grafana plugin does -->
            <readonly>2</readonly>
            <max_execution_time>60</max_execution_time>
            <max_memory_usage>2000000000</max_memory_usage>
            <priority>5</priority>
            <constraints>
                <max_execution_time><min>1</min><max>120</max></max_execution_time>
                <max_memory_usage><min>1</min><max>2000000000</max></max_memory_usage>
                <priority><min>5</min></priority>
            </constraints>
        </nt_reader>
    </profiles>
    <users>
        <nt_reader>
            <password from_env="CLICKHOUSE_RO_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>nt_reader</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON telescope.*</query>
                <query>GRANT SELECT ON mgmt.*</query>
            </grants>
        </nt_reader>
    </users>
</clickhouse>
